{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Playwright: slow demo (headed)",
      "type": "shell",
      "command": "npm run test:e2e:demo",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Playwright: slow demo + UI",
      "type": "shell",
      "command": "cross-env E2E_SLOW_MO=500 npx playwright test --ui",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
