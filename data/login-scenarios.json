  {
    "id": "invalid-Login",
    "description": "Wrong credentials shows error and stay on login",
    "usernameEnvKey": "E2E_INVALID_USERNAME",
    "passwordEnvKey": "E2E_INVALID_PASSWORD",
    "expectSuccess": false,
    "expectedErrorContains": "Username and password do not match",
    "expectedInventoryVisibleText": "Products"
  }
]
