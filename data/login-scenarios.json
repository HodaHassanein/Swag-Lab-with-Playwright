[
  {
    "id": "successful-Login",
    "description": "Successful login with valid credentials redirects to inventory",
    "usernameEnvKey": "E2E_VALID_USERNAME",
    "passwordEnvKey": "E2E_VALID_PASSWORD",
    "expectSuccess": true,
    "expectedInventoryUrlPart": "inventory.html",
    "expectedPageTitlePart": "Swag Labs",
    "expectedInventoryVisibleText": "Products"
