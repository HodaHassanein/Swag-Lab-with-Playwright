# Copy this file to .env for local runs (never commit .env)

# Optional: override base URL (defaults to https://www.saucedemo.com)
# BASE_URL=https://www.saucedemo.com

# Optional: slow down each browser action in ms — useful for demos (e.g. 400). Remove or set to 0 for fast runs.
# E2E_SLOW_MO=400

# Data-driven login scenarios (see data/login-scenarios.json)
E2E_VALID_USERNAME=standard_user
E2E_VALID_PASSWORD=secret_sauce
E2E_INVALID_USERNAME=not_a_real_user
E2E_INVALID_PASSWORD=wrong_password

# Checkout E2E (see data/checkout-scenarios.json)
E2E_CHECKOUT_FIRST_NAME=Test
E2E_CHECKOUT_LAST_NAME=User
E2E_CHECKOUT_POSTAL_CODE=12345